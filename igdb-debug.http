@client_id     = az2v0kaikq50xi87aqi68qftadgt0c
@client_secret = 8zq1tspb07ds5dymo0su7x1rup1r6y

# Change these to test different games:
@steam_app_id    = 292030
@gog_product_id  = 1207664663
@epic_slug       = alan-wake-remastered

###
# 1. Get token — run this first, others use it automatically
# @name getToken
POST https://id.twitch.tv/oauth2/token?client_id={{client_id}}&client_secret={{client_secret}}&grant_type=client_credentials

###
# 2a. IGDB step 1 — fetch popular main games (external_games returns as plain integer IDs)
POST https://api.igdb.com/v4/games
Client-ID: {{client_id}}
Authorization: Bearer {{getToken.response.body.access_token}}
Content-Type: text/plain

fields id, name, summary, cover.image_id, genres.name, 
       external_games.external_game_source, external_games.game_release_format, external_games.uid;
where game_type = 0 & version_parent = null & external_games != null;
sort total_rating_count desc;
limit 10;
offset 0;

###
# 2b. IGDB step 2 — resolve external_game IDs to Steam/GOG/Epic uid+category
# Paste IDs from 2a's external_games arrays into the where clause
POST https://api.igdb.com/v4/external_games
Client-ID: {{client_id}}
Authorization: Bearer {{getToken.response.body.access_token}}
Content-Type: text/plain

fields id,category,uid,game;
where id = (1935351,1935867,1932096,123664) & category = (1,5,26);
limit 500;

###
# 3. Steam price — exact copy of what SteamService sends
GET https://store.steampowered.com/api/appdetails?appids={{steam_app_id}}&cc=us&filters=price_overview

###
# 4. GOG price — exact copy of what GogService sends
GET https://api.gog.com/products/prices?ids={{gog_product_id}}&countryCode=US

###
# 5. IGDB — find games with Epic slugs (category 26); check uid format
POST https://api.igdb.com/v4/external_games
Client-ID: {{client_id}}
Authorization: Bearer {{getToken.response.body.access_token}}
Content-Type: text/plain

fields id,category,uid,game;
where category = 26;
limit 10;

###
# 6. Epic price — exact copy of what EpicService sends
#    Expected path: data.Catalog.catalogOffer.price.totalPrice.{discountPrice,originalPrice} (cents)
POST https://store.epicgames.com/api/graphql
Content-Type: application/json

{
  "query": "query CatalogOffer($productSlug: String!, $locale: String!, $country: String!) { Catalog { catalogOffer(productSlug: $productSlug, locale: $locale, country: $country) { price { totalPrice { discountPrice originalPrice } } } } }",
  "variables": {
    "productSlug": "{{epic_slug}}",
    "locale": "en-US",
    "country": "US"
  }
}

###
# 7. GOG product info — returns "slug" field useful for URL building verification
GET https://api.gog.com/products/{{gog_product_id}}

###
# 8. IGDB — GOG external games; verify uid format (slugs vs numeric IDs)
POST https://api.igdb.com/v4/external_games
Client-ID: {{client_id}}
Authorization: Bearer {{getToken.response.body.access_token}}
Content-Type: text/plain

fields id,category,uid,game;
where category = 5;
limit 10;
